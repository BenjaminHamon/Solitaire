#Body {
    display: flex;
    flex-direction: row;
    justify-content: center;
    flex-grow: 1;
}

#MainMenu {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 40%;
}

#MainMenu Label {
    border-bottom-width: 2%;
}

#MainMenu TextField {
    max-height: 20%;
}

#MainMenu TextInput {
    padding: 2%;
}

#MainMenu > #NewGameButton {
    margin: 2%;
    margin-top: 4%;
}

#MainMenu > #SeedGroup {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
}

#MainMenu > #SeedGroup > * {
    margin: 2%;
}

#MainMenu > #SeedGroup > #SeedLabel {
    -unity-text-align: middle-center;
}

#MainMenu > #SeedGroup > #SeedInput > TextInput {
    -unity-text-align: middle-right;
}

#MainMenu > #SeedGroup > #SeedGroupButtons {
    display: flex;
    flex-direction: row;
    flex-grow: 0;
}

#MainMenu > #SeedGroup > #SeedGroupButtons > Button {
    flex-basis: 0;
    flex-grow: 1;
}

#MainMenu > #SeedGroup > #SeedGroupButtons > Button {
    margin: 0;
    margin-right: 10%;
}

#MainMenu > #SeedGroup > #SeedGroupButtons > #LastSeedButton {
    margin-right: 0;
}

#MainMenu > #ExitButton {
    margin: 2%;
    margin-bottom: 4%;
    margin-top: auto;
}
